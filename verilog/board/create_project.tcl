# ============================================================
# create_project.tcl — Quartus project for the DE10-Standard (Milestone C3)
#
#   cd verilog/board
#   quartus_sh -t create_project.tcl
#
# Creates gsl_board.qpf / .qsf (device, top level, files, pins) and copies
# the coefficient files the detector reads with $readmemh into this
# directory (the project directory). Pin assignments are Terasic's, taken
# from DE10_Standard_default.qsf for the signals gsl_top uses.
# ============================================================
package require ::quartus::project

project_new gsl_board -overwrite

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY gsl_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE gsl_top.v
set_global_assignment -name QSYS_FILE gsl_sys.qsys
set_global_assignment -name SDC_FILE gsl_top.sdc
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

